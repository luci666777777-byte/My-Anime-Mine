    local exact, frags = {}, {}
    for _, r in ipairs(ROWS) do
        exact[r[1]] = r
        frags[#frags + 1] = r
    end
    table.sort(frags, function(a, b)
        return #a[1] > #b[1]
    end)

    local function hasThai(s)
        return string.find(s, "\224[\184\185]") ~= nil
    end

    local function plainReplace(s, a, b)
        local i, j = string.find(s, a, 1, true)
        if not i then
            return s
        end
        local parts, pos = {}, 1
        while i do
            parts[#parts + 1] = string.sub(s, pos, i - 1)
            parts[#parts + 1] = b
            pos = j + 1
            i, j = string.find(s, a, pos, true)
        end
        parts[#parts + 1] = string.sub(s, pos)
        return table.concat(parts)
    end

    local function translate(s, lang)
        if lang == "th" or s == "" or not IDX[lang] then
            return s
        end
        if s == LocalPlayer.DisplayName or s == tostring(game.Name) then
            return s
        end
        local r = exact[s]
        if r then
            return r[IDX[lang]] or s
        end
        if not hasThai(s) then
            return s
        end
        local out = s
        for _, f in ipairs(frags) do
            local v = f[IDX[lang]]
            if v and string.find(out, f[1], 1, true) then
                out = plainReplace(out, f[1], v)
            end
        end
        return out
    end

    local lang = Config.Language
    if not IDX[lang] and lang ~= "th" then
        lang = "th"
    end

    local orig = setmetatable({}, { __mode = "k" })
    local shown = setmetatable({}, { __mode = "k" })

    local function apply(l)
        local o = orig[l]
        if o == nil then
            return
        end
        local t = translate(o, lang)
        if l.Text ~= t then
            shown[l] = t
            l.Text = t
        else
            shown[l] = l.Text
        end
    end

    local function track(l)
        if orig[l] ~= nil then
            return
        end
        if not (l:IsA("TextLabel") or l:IsA("TextButton")) then
            return
        end
        orig[l] = l.Text
        Track(l:GetPropertyChangedSignal("Text"):Connect(function()
            if l.Text == shown[l] then
                return
            end
            orig[l] = l.Text
            apply(l)
        end))
        apply(l)
    end

    local function applyAll()
        for l in pairs(orig) do
            pcall(apply, l)
        end
    end

    Track(Screen.DescendantAdded:Connect(function(d)
        pcall(track, d)
    end))
    for _, d in ipairs(Screen:GetDescendants()) do
        pcall(track, d)
    end

