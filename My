Floating.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        floatingDragging = true
        dragStartPos = input.Position
        startPos = Floating.Position
    end
end)
Floating.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        floatingDragging = false
        Config.FloatX = Floating.Position.X.Scale
        Config.FloatY = Floating.Position.Y.Scale
        SaveConfig()
    end
end)
UIS.InputChanged:Connect(function(input)
    if floatingDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStartPos
        local pos = startPos + UDim2.new(delta.X / Screen.AbsoluteSize.X, 0, delta.Y / Screen.AbsoluteSize.Y, 0)
        Floating.Position = UDim2.new(clamp(pos.X.Scale, 0.02, 0.96), 0, clamp(pos.Y.Scale, 0.02, 0.96), 0)
    end
end)

Floating.MouseButton1Click:Connect(function()
    ToggleWindow()
end)

local statsFrame = New("Frame", {
    Name = STATS_NAME,
    Size = UDim2.fromOffset(200, 90),
    Position = UDim2.fromScale(Config.StatsX, Config.StatsY),
    BackgroundColor3 = Theme.Surface,
    BorderSizePixel = 0,
    Visible = Config.StatsVisible,
}, PlayerGui)
Corner(statsFrame, 18)
Stroke(statsFrame, Theme.Stroke, 1, 0.35)

local syncText = Text(statsFrame, "JOD HUB ONLINE", 16, Enum.Font.GothamBold, Theme.Text)
syncText.Position = UDim2.new(0, 16, 0, 10)
syncText.Size = UDim2.new(1, -32, 0, 24)

local syncSub = Text(statsFrame, "Status: READY", 12, Enum.Font.GothamMedium, Theme.Muted)
syncSub.Position = UDim2.new(0, 16, 0, 38)
syncSub.Size = UDim2.new(1, -32, 0, 18)

local function UpdateStats()
    if statsFrame then
        statsFrame.Visible = Config.StatsVisible
    end
end

UpdateStats()
ShowTab(activeTab)

_G.JodHubCleanup = function()
    if Screen then
        Screen:Destroy()
    end
    if Floating then
        Floating:Destroy()
    end
    if statsFrame then
        statsFrame:Destroy()
    end
end

print("[JOD HUB] Loaded successfully.")
