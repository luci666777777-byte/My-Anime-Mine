    local desc = Text(row, "เปลี่ยนภาษาของเมนูทั้งหมดทันที", 12, FNT.R, "Sub")
    desc.Position = UDim2.fromOffset(18, 31)
    desc.Size = UDim2.new(1, -36, 0, 18)

    local holder = New("Frame", {
        Size = UDim2.new(1, -28, 0, 32),
        Position = UDim2.fromOffset(14, 58),
        BackgroundTransparency = 1,
    }, row)
    New("UIGridLayout", {
        CellSize = UDim2.new(1 / #LANGS, -6, 0, 32),
        CellPadding = UDim2.fromOffset(6, 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, holder)

    local cells = {}
    local function render()
        for code, c in pairs(cells) do
            local on = code == lang
            c.BackgroundColor3 = on and Theme.Accent or Theme.Surface2
            c.TextColor3 = on and Theme.OnAccent or Theme.Sub
        end
    end

    for i, L in ipairs(LANGS) do
        local c = New("TextButton", {
            BorderSizePixel = 0,
            Text = L[2],
            TextSize = 12,
            Font = FNT.M,
            AutoButtonColor = false,
            LayoutOrder = i,
        }, holder)
        Corner(c, 10)
        cells[L[1]] = c
        c.MouseButton1Click:Connect(function()
            if lang == L[1] then
                return
            end
            lang = L[1]
            SetConfig("Language", lang)
            PlayToggleSound(true)
            render()
            applyAll()
            Toast(L[2])
        end)
    end
    OnTheme(render)

    Refreshers[#Refreshers + 1] = function()
        local l = Config.Language
        lang = (IDX[l] or l == "th") and l or "th"
        render()
        applyAll()
    end

    -- sweep แรก (บางข้อความถูกตั้งหลังสร้าง)
    task.delay(0.3, applyAll)
end)()

