    local function SplitSel(str)
        local m = {}
        for name in string.gmatch(tostring(str or ""), "[^|]+") do
            m[name] = true
        end
        return m
    end

    local function JoinSel(values, m)
        local t = {}
        for _, v in ipairs(values) do
