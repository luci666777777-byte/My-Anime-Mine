    --==================================================
    local function updateStatus()
        local d = GameState and GameState.GetData2()
        local money = d and d.Money or 0
        local mg = d and d.MineGame
        local curZ = mg and mg.CurrentZone or 1
        local zdef = MineConfig and MineConfig.Zones and MineConfig.Zones["Z" .. tostring(curZ)]
        local zoneName = zdef and zdef.DisplayName or ("Zone " .. tostring(curZ))
        local highestPick = "-"
        if mg and mg.Pickaxes then
            for pName, _ in pairs(mg.Pickaxes) do
                highestPick = pName
            end
        end

        homePara:SetTitle(string.format("เงิน $%s  (+$%s)", formatCash(money), formatCash(FarmState.TotalProfit)))
        homePara:SetDesc(string.format("โซน: %s  •  อีเตอร์: %s", zoneName, highestPick))

        pcall(function()
            if MineStock and GameState then
                local secLeft = MineStock.SecondsLeft and MineStock.SecondsLeft() or 0
                local timeFmt = MineStock.FormatTime and MineStock.FormatTime(secLeft) or string.format("%ds", secLeft)
                local selected = 0
                for _, v in pairs(FarmState.SelectedPickaxes or {}) do
                    if v == true then
                        selected = selected + 1
                    end
                end
                pickPara:SetTitle(string.format("ปัจจุบัน: %s | สต็อกรีใน: %s | เลือกไว้: %d เล่ม", highestPick, timeFmt, selected))
                pickPara:SetDesc("สถานะ: " .. (FarmState.AutoBuyPickaxes and "Auto Buy ทำงาน" or "Auto Buy ปิดอยู่"))
            end
        end)

        pcall(function()
            if MineConfig and GameState then
                local nextDef, nextCost = nil, 0
                if mg and mg.UnlockedZones then
                    for _, zk in ipairs(MineConfig.ZoneKeys) do
                        if not mg.UnlockedZones[zk] then
                            nextDef = MineConfig.Zones[zk]
                            nextCost = tonumber(nextDef and nextDef.UnlockCost) or 0
                            break
                        end
                    end
                end
                local nodes = MineConfig.GetSkillNodes("Z" .. tostring(curZ))
                local skills = mg and mg.Skills and mg.Skills["Z" .. tostring(curZ)] or {}
                local total, maxed = nodes and #nodes or 0, 0
                if nodes then
                    for _, n in ipairs(nodes) do
                        if MineConfig.IsSkillNodeMaxed(skills, n) then
                            maxed = maxed + 1
                        end
                    end
                end
                local pct = total > 0 and math.floor(maxed / total * 100) or 100
                local nextText = nextDef
                        and string.format("โซนถัดไป: %s (ราคา $%s)", nextDef.DisplayName, formatCash(nextCost))
                    or "ปลดล็อคครบทุกโซนแล้ว"
                local ready = nextDef and ((money >= nextCost) and "  [เงินพร้อมปลดล็อค]" or "  [กำลังสะสมเงิน...]") or ""
                zonePara:SetTitle(string.format("โซนปัจจุบัน: %s (Z%d)  |  วิจัย: %d%%", zoneName, curZ, pct))
                zonePara:SetDesc(nextText .. ready)

                local ranked = getRankedMiners()
                local top = ranked and ranked[1]
                if top then
                    local function lv(cur, mx)
                        return cur >= mx and "MAX" or (tostring(cur) .. "/" .. tostring(mx))
                    end
                    local varTag = (top.variant and top.variant ~= "Normal") and (" (" .. top.variant .. ")") or ""
                    minerPara:SetTitle(string.format("ตัวเทพสุด: %s - %s%s", top.key, top.char, varTag))
                    minerPara:SetDesc(string.format(
                        "Damage: %s | Speed: %s | Mining: %s",
                        lv(top.dmgLvl, top.maxDmgLvl), lv(top.spdLvl, top.maxSpdLvl), lv(top.mineLvl, top.maxMineLvl)
                    ))
                else
                    minerPara:SetTitle("ตัวเทพสุด: ยังไม่พบคนขุด")
                    minerPara:SetDesc("กรุณาติดตั้งคนขุดบนแท่นขุด")
                end
            end
        end)
    end

    task.spawn(function()
        while alive() do
            pcall(updateStatus)
            task.wait(0.5)
        end
    end)

    print("[RELWX] My Anime Mine functions loaded")
end)()


