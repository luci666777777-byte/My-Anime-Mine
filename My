    local function upgradeMiner(m, money)
        local n = 0
        if isStatSelected("Speed") and m.spdLvl < m.maxSpdLvl and money >= m.spdCost then
            GameState.SendEvent("MineUpgradeCharacter", m.key, "Speed")
            money = money - m.spdCost
            n = n + 1
            task.wait(0.08)
        end
        if isStatSelected("Mining Speed") and m.mineLvl < m.maxMineLvl and money >= m.mineCost then
            GameState.SendEvent("MineUpgradeCharacter", m.key, "MineSpeed")
            money = money - m.mineCost
            n = n + 1
            task.wait(0.08)
        end
        if isStatSelected("Damage") and m.dmgLvl < m.maxDmgLvl and money >= m.dmgCost then
            GameState.SendEvent("MineUpgradeCharacter", m.key, "Damage")
            money = money - m.dmgCost
            n = n + 1
            task.wait(0.08)
        end
        return n, money
    end

