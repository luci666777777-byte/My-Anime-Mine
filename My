    local function formatCash(n)
        n = tonumber(n) or 0
        local units = {
            { 1e33, "Dc" }, { 1e30, "No" }, { 1e27, "Oc" }, { 1e24, "Sp" }, { 1e21, "Sx" },
            { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" },
        }
        for _, u in ipairs(units) do
            if n >= u[1] then
                return string.format("%.2f%s", n / u[1], u[2])
            end
        end
        return tostring(math.floor(n))
    end

