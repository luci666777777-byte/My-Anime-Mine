local function LoadConfig()
    if not (isfile and readfile) then
        return
    end
    local ok, exists = pcall(isfile, CONFIG_FILE)
    if not (ok and exists) then
        return
    end
    pcall(function()
        local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
        if type(data) == "table" then
            for k, v in pairs(Defaults) do
                if type(data[k]) == type(v) then
                    Config[k] = data[k]
                end
            end
        end
    end)
end

LoadConfig()

local function SaveConfig()
    if writefile then
        pcall(function()
            writefile(CONFIG_FILE, HttpService:JSONEncode(Config))
        end)
    end
end

local Theme = {}
local function HexToColor(hex)
    local ok, c = pcall(function()
        return Color3.fromHex(hex)
    end)
    return ok and c or RGB(168, 85, 247)
end

local function ComputeTheme()
    local bg = HexToColor(Config.UIBackgroundColor)
    local dark = (0.299 * bg.R + 0.587 * bg.G + 0.114 * bg.B) < 0.5
    local to = dark and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
    Theme.Bg = bg
    Theme.Surface = bg:Lerp(to, 0.05)
    Theme.Surface2 = bg:Lerp(to, 0.11)
    Theme.Stroke = bg:Lerp(to, 0.18)
    Theme.Text = dark and RGB(244, 244, 244) or RGB(20, 20, 20)
    Theme.Sub = Theme.Text:Lerp(bg, 0.18)
    Theme.Muted = Theme.Text:Lerp(bg, 0.38)
    Theme.Accent = HexToColor(Config.UIAccentColor)
    Theme.Button = HexToColor(Config.UIButtonColor)
    local h, s, v = Theme.Accent:ToHSV()
    Theme.Accent2 = (s < 0.12) and Theme.Accent:Lerp(Color3.fromRGB(96, 104, 128), 0.6) or Color3.fromHSV((h + 0.12) % 1, s, math.max(v, 0.6))
end
ComputeTheme()

local function ApplyTheme()
    ComputeTheme()
    if Main then
        Main.BackgroundColor3 = Theme.Bg
    end
    if Title then
        Title.TextColor3 = Theme.Text
    end
    if TabHolder then
        for _, child in ipairs(TabHolder:GetChildren()) do
            if child:IsA("TextButton") then
                child.TextColor3 = Theme.Text
            end
        end
    end
end

local function AddGlow(parent, color, size, pos, rot)
    local glow = New("Frame", {
        Name = "Glow",
        Size = UDim2.fromOffset(size, size),
        Position = pos,
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 1,
    }, parent)
    local g = New("UIGradient", {
        Rotation = rot,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.45, 0.8),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, glow)
    g.Color = ColorSequence.new(color, color:Lerp(Color3.new(1, 1, 1), 0.3))
    return glow
end

local function CreateTabButton(parent, text, tabName, active)
    local btn = New("TextButton", {
        Size = UDim2.new(0, 110, 0, 36),
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = Theme.Text,
        BackgroundColor3 = Theme.Surface,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        AutoButtonColor = false,
    }, parent)
    Corner(btn, 12)
    Stroke(btn, Theme.Stroke, 1, 0.4)
    local accent = New("Frame", {
        Size = UDim2.new(1, -8, 0, 2),
        Position = UDim2.new(0, 4, 1, -4),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Visible = active,
    }, btn)
    Corner(accent, 100)
    btn.MouseEnter:Connect(function()
        Tween(btn, 0.12, { BackgroundColor3 = Theme.Surface2 }, Enum.EasingStyle.Quad)
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, 0.12, { BackgroundColor3 = Theme.Surface }, Enum.EasingStyle.Quad)
    end)
    btn.MouseButton1Click:Connect(function()
        for _, child in ipairs(TabHolder:GetChildren()) do
            if child:IsA("TextButton") then
                local bar = child:FindFirstChild("_Accent")
                if bar then
                    bar.Visible = false
                end
            end
        end
        accent.Visible = true
        Config.LastTab = tabName
        SaveConfig()
        ShowTab(tabName)
    end)
    accent.Name = "_Accent"
    return btn
end

local function CreateToggle(parent, labelText, key, defaultValue)
    local value = defaultValue
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)
    local txt = Text(row, labelText, 14, Enum.Font.GothamSemibold, Theme.Text)
    txt.Size = UDim2.new(1, -90, 1, 0)
    txt.Position = UDim2.new(0, 12, 0, 0)
    local toggle = New("TextButton", {
        Size = UDim2.new(0, 62, 0, 28),
        Position = UDim2.new(1, -74, 0.5, -14),
        BackgroundColor3 = Theme.Surface,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, row)
    Corner(toggle, 14)
    local knob = New("Frame", {
        Size = UDim2.fromOffset(24, 24),
        Position = UDim2.new(0, 4, 0.5, -12),
        BackgroundColor3 = RGB(255, 255, 255),
        BorderSizePixel = 0,
    }, toggle)
    Corner(knob, 12)
    local function Refresh()
        value = Config[key]
        if value then
            toggle.BackgroundColor3 = Theme.Accent
            knob.Position = UDim2.new(1, -28, 0.5, -12)
        else
            toggle.BackgroundColor3 = Theme.Surface2
            knob.Position = UDim2.new(0, 4, 0.5, -12)
        end
    end
    Refresh()
    toggle.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        SaveConfig()
        Refresh()
    end)
    return row
end

local function CreateSlider(parent, labelText, key, minValue, maxValue, step)
    local row = New("Frame", {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, parent)
    local label = Text(row, labelText, 13, Enum.Font.GothamSemibold, Theme.Text)
    label.Size = UDim2.new(1, -120, 0, 22)
    label.Position = UDim2.new(0, 12, 0, 6)
    local valueLabel = Text(row, tostring(Config[key]), 12, Enum.Font.GothamMedium, Theme.Accent)
    valueLabel.Size = UDim2.new(0, 60, 0, 20)
    valueLabel.Position = UDim2.new(1, -76, 0, 6)
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right

    local fill = New("Frame", {
        Size = UDim2.new(1, -24, 0, 8),
        Position = UDim2.new(0, 12, 1, -18),
        BackgroundColor3 = Theme.Surface2,
        BorderSizePixel = 0,
    }, row)
    Corner(fill, 100)
    local bar = New("Frame", {
        Size = UDim2.new(0.5, 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    }, fill)
    Corner(bar, 100)
    local drag = New("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, fill)
    local function Refresh()
        local v = clamp(Config[key], minValue, maxValue)
        local percent = (v - minValue) / (maxValue - minValue)
        bar.Size = UDim2.new(percent, 0, 1, 0)
        valueLabel.Text = tostring(v)
    end
    Refresh()
    local dragging = false
    drag.MouseButton1Down:Connect(function()
        dragging = true
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    RunService.RenderStepped:Connect(function()
        if dragging then
            local mousePos = UIS:GetMouseLocation()
            local abs = fill.AbsolutePosition
            local sizeX = fill.AbsoluteSize.X
            local ratio = clamp((mousePos.X - abs.X) / sizeX, 0, 1)
            local value = minValue + ratio * (maxValue - minValue)
            Config[key] = math.floor(value / step + 0.5) * step
            SaveConfig()
            Refresh()
        end
    end)
    return row
end

